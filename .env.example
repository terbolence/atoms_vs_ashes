# Database connection (API-populated — default profile)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=atoms_vs_ashes
POSTGRES_USER=atoms
POSTGRES_PASSWORD=changeme

# LLM-populated database (used with --db-profile llm or POSTGRES_DB override)
# POSTGRES_DB=atoms_vs_ashes_llm
#
# Switch via CLI:
#   atoms-vs-ashes --db-profile llm <command>
# Or via env var:
#   POSTGRES_DB=atoms_vs_ashes_llm atoms-vs-ashes <command>
# Or for Alembic migrations:
#   POSTGRES_DB=atoms_vs_ashes_llm alembic upgrade head

# ── Connector API keys ──────────────────────────────────────────────
# See docs/api_keys.md for how to obtain each key.

# Copernicus CDS / ERA5  (S-04 — serves E9/NS-01, NH-10–12, RI-01)
# Free ECMWF account → Personal Access Token
# https://cds.climate.copernicus.eu/how-to-api
# CDSAPI_URL=https://cds.climate.copernicus.eu/api
# CDSAPI_KEY=<your-personal-access-token>

# ENTSO-E Transparency Platform  (S-13 / FIX-02 — serves BF-01/NS-02)
# Free account → Web API Security Token
# https://transparency.entsoe.eu/ → My Account → Web API Security Token
# ENTSOE_SECURITY_TOKEN=<your-security-token>

# WDPA / Protected Planet  (S-15 — serves E7/NS-08)
# Free registration → API token
# https://api.protectedplanet.net/request
# WDPA_TOKEN=<your-api-token>

# NOAA CDO API  (S-11 — serves NH-10/NH-11/NH-12)
# Free token at https://www.ncei.noaa.gov/cdo-web/token
# Rate limits: 5 req/s, 10,000 req/day
# NOAA_CDO_TOKEN=<your-cdo-token>

# GeoNames  (population connector — serves E8/EP-01)
# Free account registration
# https://www.geonames.org/login  → enable free web services in account settings
# GEONAMES_USERNAME=<your-username>

# Google Earth Engine  (S-06 — optional; OFF by default in config/default.yml)
# Requires Google Cloud project + Earth Engine access (may require Google app review).
# Install: pip install 'atoms-vs-ashes[earth-engine]'
# Then set connectors.earth_engine.enabled: true and:
# GEE_PROJECT_ID=<your-gcp-project-id>
# GEE_SERVICE_ACCOUNT_EMAIL=<client_email from JSON>
# GEE_SERVICE_ACCOUNT_KEY=/absolute/path/to/key.json

# ── LLM assessment pipeline (Anthropic Claude) ─────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
