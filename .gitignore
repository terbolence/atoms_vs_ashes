.venv/
venv/

# Environment files
.env

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Data artifacts
*.tmp
outputs/

# LLM API call logs (contain full prompts and responses)
logs/llm/

# Connector HTTP audit logs (full request/response bodies; can grow large)
logs/seismic/
logs/entso_e/

